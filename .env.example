# ─── Database ─────────────────────────────────────────────────────────
# PostgreSQL connection string
# Render provides this automatically via the render.yaml database link
DATABASE_URL=postgresql://cdmo:password@localhost:5432/cdmo

# ─── Server ──────────────────────────────────────────────────────────
# Port the Express server listens on (Render sets this automatically)
PORT=3001

# Node environment: "development" or "production"
NODE_ENV=development

# Allowed CORS origin for the frontend
# In production, Render sets this from the static site URL
CORS_ORIGIN=http://localhost:5173

# ─── Client (Vite) ──────────────────────────────────────────────────
# API base URL used by the React frontend
# In development, Vite proxies /api to the server automatically
# In production, render.yaml rewrites handle this
VITE_API_URL=http://localhost:3001
